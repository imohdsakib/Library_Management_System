{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "Library Management System backend (Node.js + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:mysql": "powershell -ExecutionPolicy Bypass -File ./start-mysql.ps1",
    "start:backend": "powershell -ExecutionPolicy Bypass -File ./start-backend.ps1",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1",
    "smoke": "powershell -ExecutionPolicy Bypass -File ./e2e-smoke.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File ./check-system.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
